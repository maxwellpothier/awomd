# Copy to .env.local (gitignored). Never commit real values.

# Where `npm run send` fetches the email render from.
# Point this at a running app: `npm run dev` or `npm run start`.
SEND_ORIGIN=http://localhost:3000

# Absolute origin baked into the email's image and link URLs.
# Set this when running the app for a real send, or recipients get localhost.
SITE_URL=https://awomd.com

# Envelope. The From domain must be verified in the relay.
SEND_FROM="Max <max@awomd.com>"
SEND_REPLY_TO=max@awomd.com

# Where `--to me` goes.
SEND_SELF_TO=you@example.com

# Relay credential. Resend → API keys.
RESEND_API_KEY=

# Signs the relay's webhooks to /api/webhooks/relay, which records bounces and
# spam complaints. Resend → Webhooks → the endpoint → Signing secret (whsec_…).
RESEND_WEBHOOK_SECRET=

# Supabase. Subscribers, sends, and tracking events live here — nothing else.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role, NOT the anon/publishable key. The send command and the token
# endpoints write as a trusted server and bypass RLS. Never ships to a browser.
SUPABASE_SERVICE_ROLE_KEY=

